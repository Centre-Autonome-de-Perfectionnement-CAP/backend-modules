APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=aws-1-eu-north-1.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.fkjdgkeebzrsoaunjzar
# DB_PASSWORD=4wF5NKBuxgSN5iV4

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@cap-epac.online"
MAIL_FROM_NAME="CAP - Centre Autonome de Perfectionnement"

# Destinataires des emails de contact
MAIL_CONTACT_TO=contact@cap-epac.online
MAIL_CONTACT_CC=owomax@gmail.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── WhatsApp Node Service ─────────────────────────────────────────────────────
# URL du service Node (toujours loopback — jamais exposé publiquement)
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3005
WHATSAPP_BRIDGE_TIMEOUT=30

# Clé API partagée Laravel <-> Node (header X-Api-Key)
# Générer : openssl rand -hex 32
# OBLIGATOIRE en production (le Node refusera de démarrer sans elle)
WHATSAPP_BRIDGE_API_KEY=

# Clé de chiffrement AES-256-GCM des sessions Baileys en base de données
# Générer : openssl rand -hex 32
# OBLIGATOIRE — sans cette clé le Node ne démarrera pas
WA_SESSION_ENCRYPTION_KEY=

# Port d'écoute du Node (doit correspondre à WHATSAPP_BRIDGE_URL ci-dessus)
WHATSAPP_NODE_PORT=3005

# true = la commande artisan whatsapp:node:start démarre le Node si absent
# En production avec Supervisor (recommandé), laisser à false
WA_AUTO_START=false
